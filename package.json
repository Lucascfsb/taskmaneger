{
  "name": "task-management-api",
  "version": "1.0.0",
  "description": "API REST para gerenciamento de tarefas e equipes com níveis de acesso.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch --env-file .env src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup src --out-dir build --format esm --clean",
    "start": "node build/server.js",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "Lucas Castro Fernandes",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
